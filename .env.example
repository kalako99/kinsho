# Copy this file to .env and fill in your real values.
# .env is gitignored — it never gets committed or pulled, so editing it
# never conflicts with `git pull` and never needs a commit of its own.

KINSHO_UID=1000
KINSHO_GID=1000
KINSHO_PORT=8000
KINSHO_DATA_PATH=/srv/appdata/kinsho
KINSHO_MANGA_PATH=/mnt/wdred/Media/Manga
